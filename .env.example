APP_NAME="EduKSX-Glossary"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_CH
APP_TIMEZONE=Europe/Zurich

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Datenbank: zu Beginn SQLite, eine Datei (docs/KONZEPT-DATENMODELL.md); PostgreSQL folgt (#191, DEC-028).
DB_CONNECTION=sqlite
# DB_DATABASE=storage/app/database/glossary.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Im Betrieb (HTTPS) true; Standard: true bei APP_ENV=production (#37)
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Mail-Versand: in der Administration (System › «Versand einrichten», #302); MAIL_MAILER hier hätte Vorrang und
# sperrt die Einrichtung dort. Ohne Einrichtung werden keine Mails versendet (Protokoll).
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Spam-Schutz bei der Registrierung (Cloudflare Turnstile, #41); leer = aus
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Anmeldung mit Microsoft (#45); leer = Knopf ausgeblendet. Secret nie ins Repository
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Ereignisse von EduKSX-Ident (#187); leer = Empfang aus. Schlüssel nie ins Repository; beim Wechsel beide, mit Komma
EDUKSX_EVENTS_KEYS=
EDUKSX_EVENTS_SOURCES=

VITE_APP_NAME="${APP_NAME}"

# EduKSX-Glossary
# Vom Deployment gesetzt (Versionsanzeige, Developer Release)
GLOSSARY_BUILD=
GLOSSARY_BUILD_DATE=
GLOSSARY_BUILD_DESCRIBE=
# Repository für «Fehler melden» / «Idee vorschlagen»; leer = Knöpfe ausblenden
GLOSSARY_GITHUB_REPO=MarkusKeller8200/EduKSX-Glossary
GLOSSARY_PAGES_URL=https://markuskeller8200.github.io/EduKSX-Glossary/

# ---------------------------------------------------------------------------------------------------------------
# Betrieb auf einem Server (docker/compose.yaml bzw. docker/compose.prod.yaml, #196, docs/KONZEPT-DEPLOYMENT.md)
# Vorlage für /…/glossary/.env – die Werte oben für lokal gelten im Container nicht (das Image setzt APP_ENV=production,
# APP_DEBUG=false, SESSION_DRIVER/CACHE_STORE=database, SQLite im Volumen). Prüfen: php artisan glossary:pruefen
# Geheimnisse wahlweise als Datei: NAME_FILE=/run/secrets/name statt NAME=… (z. B. APP_KEY_FILE, MAIL_PASSWORD_FILE).
# ---------------------------------------------------------------------------------------------------------------
# Adresse ohne https:// (Pflicht); daraus wird APP_URL
# GLOSSARY_HOST=glossary.example.ch
# Image und Port (docker/compose.yaml); Vorgabe latest bzw. 8080 auf 127.0.0.1
# GLOSSARY_IMAGE=ghcr.io/markuskeller8200/eduksx-glossary:latest
# GLOSSARY_PORT=8080
# Schlüssel: leer = im Volumen einmalig erzeugt (storage/app/.app_key)
# APP_KEY=
# Mail über die Umgebung statt der Administration (Beispiele in DEPLOY.md, Abschnitt E-Mail-Versand)
# MAIL_MAILER=smtp
# MAIL_HOST=mail.infomaniak.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=
# MAIL_PASSWORD_FILE=/run/secrets/mail_password
# MAIL_FROM_ADDRESS=noreply@example.ch
# Warteschlange für Mails mit Wiederholung (Dienst «worker»)
# QUEUE_CONNECTION=database

# Vollständiger Dump (#268): Passwort vorschreiben (später true); Passwort für «php artisan glossary:dump» ohne Eingabe
GLOSSARY_DUMP_REQUIRE_PASSWORD=false
GLOSSARY_DUMP_PASSWORD=
