APP_NAME="EduKSX-Glossary"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_CH
APP_TIMEZONE=Europe/Zurich

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Datenbank: SQLite, eine Datei (docs/KONZEPT-DATENMODELL.md). Kein PostgreSQL.
DB_CONNECTION=sqlite
# DB_DATABASE=storage/app/database/glossary.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Im Betrieb (HTTPS) true; Standard: true bei APP_ENV=production (#37)
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Spam-Schutz bei der Registrierung (Cloudflare Turnstile, #41); leer = aus
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"

# EduKSX-Glossary
# Vom Deployment gesetzt (Versionsanzeige, Developer Release)
GLOSSARY_BUILD=
GLOSSARY_BUILD_DATE=
GLOSSARY_BUILD_DESCRIBE=
# Repository für «Fehler melden» / «Idee vorschlagen»; leer = Knöpfe ausblenden
GLOSSARY_GITHUB_REPO=MarkusKeller8200/EduKSX-Glossary
GLOSSARY_PAGES_URL=https://markuskeller8200.github.io/EduKSX-Glossary/
