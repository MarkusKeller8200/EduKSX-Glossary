{
  "info": {
    "name": "EduKSX-Glossary API",
    "description": "Aus openapi/glossary-v1.json erzeugt (scripts/postman.py). Variablen: baseUrl, token (Servicekonto, nur für geschützte Endpunkte). Doku: /api/docs, ausprobieren: /api/swagger.",
    "version": "0.4.0-preview",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://glossary.eduksx.ch/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Begriffe",
      "description": "",
      "item": [
        {
          "name": "Veröffentlichte Begriffe suchen und blättern",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/terms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "terms"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "SHP",
                  "description": "Suchtext in Abkürzung, Bezeichnung, Aliasen und Kurzbeschreibung (ohne Gross-/Kleinschreibung)",
                  "disabled": true
                },
                {
                  "key": "category",
                  "value": "per",
                  "description": "Kategorie (Schlüssel oder Label)",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "current",
                  "description": "Status des Begriffs",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Übergangsweise Seiten statt Cursor; ungültige Werte ergeben 422.",
                  "disabled": true
                },
                {
                  "key": "per_page",
                  "value": "50",
                  "description": "Übergangsweise Seiten statt Cursor; ungültige Werte ergeben 422.",
                  "disabled": true
                }
              ]
            },
            "description": "Veröffentlichte Begriffe suchen und blättern.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Ein veröffentlichter Begriff",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/terms/:id_or_slug",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "terms",
                ":id_or_slug"
              ],
              "variable": [
                {
                  "key": "id_or_slug",
                  "value": "klassenlehrperson",
                  "description": "UUID, Slug oder Code des Permalinks"
                }
              ]
            },
            "description": "Ein veröffentlichter Begriff.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Kompakter Index für Renderer und Browser-Erweiterung",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/index",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "index"
              ]
            },
            "description": "Alle veröffentlichten Begriffe mit den Angaben zum Erkennen und für die Erklärbox. Mit ETag; Abnehmer laden ihn höchstens einmal täglich bzw. nach neuem Datenstand (Kopfzeile X-Glossary-Release).",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
    },
