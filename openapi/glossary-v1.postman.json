              "path": [
                "v1",
                "org",
                "terms"
              ],
              "query": [
                {
                  "key": "customized",
                  "value": "true",
                  "description": "1 = nur Begriffe mit Anpassung der Organisation",
                  "disabled": true
                }
              ]
            },
            "description": "Alle veröffentlichten Begriffe mit den gemeinsamen Werten («term») und den Anpassungen der Organisation des Servicekontos («organization_display»).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
