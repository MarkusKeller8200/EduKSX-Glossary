    {
      "name": "Servicekonten",
      "description": "Für Integrationen mit Token eines Servicekontos (#47). Lesen braucht kein Token.",
      "item": [
        {
          "name": "Token prüfen",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/service/whoami",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "service",
                "whoami"
              ]
            },
            "description": "Gibt Servicekonto, Scopes und Ablauf des Tokens zurück. Zum Prüfen bei der Einrichtung einer Integration.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Vorschlag einreichen",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/proposals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "proposals"
              ]
            },
            "description": "Neuer Begriff (ohne `term`) oder Korrektur zu einem veröffentlichten Begriff (`term` = UUID oder Slug). Felder in `changes`: official_abbreviation, official_name, short_description, description, url, alternative_aliases (Liste), categories (Liste von Schlüsseln). Landet in der Moderation, nie direkt öffentlich (#113). Scope `propose`.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"term\": \"sl-schulleitung\",\n  \"changes\": {\n    \"short_description\": \"Führt die Schule pädagogisch und organisatorisch\"\n  },\n  \"reason\": \"Rückmeldung aus dem Intranet\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Stand eines eigenen Vorschlags",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/proposals/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "proposals",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "0193a1b2-7c4d-7e8f-9a0b-000000000101",
                  "description": "UUID des Vorschlags aus der Antwort von POST /v1/proposals"
                }
              ]
            },
            "description": "Stand eines eigenen Vorschlags.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Organisation",
      "description": "Begriffe in der Darstellung einer Organisation (#148). Nur mit Token eines Servicekontos der Organisation (Scope «read-org»); nie zwischengespeichert.",
      "item": [
        {
          "name": "Begriffe in der Darstellung der Organisation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
